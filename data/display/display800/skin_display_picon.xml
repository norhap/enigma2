<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<skin>
	<windowstyle id="1" type="skinned">
		<color color="#000000" name="Background"/>
		<color color="#ffffff" name="LabelForeground"/>
		<color color="#000000" name="ListboxBackground"/>
		<color color="#ffffff" name="ListboxForeground"/>
		<color color="#000000" name="ListboxSelectedBackground"/>
		<color color="#ffffff" name="ListboxSelectedForeground"/>
		<color color="#000000" name="ListboxMarkedBackground"/>
		<color color="#ffffff" name="ListboxMarkedForeground"/>
		<color color="#000000" name="ListboxMarkedAndSelectedBackground"/>
		<color color="#ffffff" name="ListboxMarkedAndSelectedForeground"/>
		<color color="#ffffff" name="WindowTitleForeground"/>
		<color color="#000000" name="WindowTitleBackground"/>
	</windowstyle>

	<fonts>
		<font filename="nmsbd.ttf" name="FdLcD" scale="100"/>
		<font filename="verdana.ttf" name="FdLcDLight" scale="100"/>
	</fonts>

	<colors>
		<color name="transparent" value="#ffffffff" />
		<color name="red" value="#00f50808" />
		<color name="green" value="#0004c81b" />
		<color name="yellow" value="#00edf506" />
		<color name="blue" value="#00077cf5" />
		<color name="white" value="#00ffffff" />
		<color name="black" value="#00000000" />
		<color name="grey" value="#00b3b3b3" />
	</colors>

	<!-- MAIN -->

	<!-- CHANNEL SELECTION-->
	<screen name="ChannelSelectionSummary" position="0,0" size="800,480">
		<panel name="LCDPiconChannelSelectionProgramName" />
		<panel name="LCDPiconChannelSelectionProgress" />
		<panel name="LCDPiconChannelSelectionRemainingTime" />
		<panel name="LCDChannelSelectionPicon" />
		<panel name="LCDPiconStatusIcons" />
		<panel name="LCDRecordIcon" />
		<panel name="LCDPiconChannelSelectionStartTime" />
		<!-- eLabel text="-" position="520,390" size="70,70" foregroundColor="white" font="FdLcD;60" horizontalAlignment="center" verticalAlignment="center" / -->
		<panel name="LCDPiconChannelSelectionEndTime" />
	</screen>
	<screen name="ChannelSelectionRadioSummary" position="0,0" size="800,480">
		<widget source="parent.RdsDecoder" render="Label" position="40,200" size="720,150" foregroundColor="white" font="FdLcDLight;65" horizontalAlignment="center" verticalAlignment="center" zPosition="2">
			<convert type="RdsInfo">RtpText</convert>
		</widget>
	</screen>

	<!-- EPG -->
	<screen name="GraphicalEPGPIGSummary" position="0,0" size="800,480">
		<panel name="LCDPiconEPGProgramName" />
		<panel name="LCDPiconEPGProgress" />
		<panel name="LCDPiconEPGRemainingTime" />
		<panel name="LCDEPGPicon" />
		<panel name="LCDPiconStatusIcons" />
		<panel name="LCDRecordIcon" />
		<panel name="LCDPiconEPGStartTime" />
		<eLabel text="-" position="520,390" size="70,70" foregroundColor="white" font="FdLcD;60" horizontalAlignment="center" verticalAlignment="center" />
		<panel name="LCDPiconEPGSEndTime" />
	</screen>
	<screen name="GraphicalEPGSummary" position="0,0" size="800,480">
		<panel name="GraphicalEPGPIGSummary" />
	</screen>
		<screen name="GraphicalInfoBarEPGSummary" position="0,0" size="800,480">
		<panel name="GraphicalEPGPIGSummary" />
	</screen>
	<screen name="EPGSelectionMultiSummary" position="0,0" size="800,480">
		<panel name="GraphicalEPGPIGSummary" />
	</screen>

	<!-- INFOBAR -->
	<screen name="InfoBarSummary" position="0,0" size="800,480">
		<panel name="LCDPiconInfoBarProgramName" />
		<panel name="LCDPiconInfoBarProgress" />
		<panel name="LCDPiconInfoBarRemainingTime" />
		<panel name="LCDPicon" />
		<panel name="LCDPiconStatusIcons" />
		<panel name="LCDRecordIcon" />
		<!-- panel name="LCDInfoBarStartTime" / -->
		<eLabel text="-" position="520,390" size="70,70" foregroundColor="white" font="FdLcD;60" />
		<panel name="LCDPiconInfoBarEndTime" />
	</screen>

	<!-- STANDBY -->
	<screen name="StandbySummary" position="0,0" size="800,480">
		<widget source="global.CurrentTime" render="Label" position="40,50" size="720,160" font="FdLcD;150" horizontalAlignment="center" verticalAlignment="center" zPosition="10">
			<convert type="ClockToText"></convert>
		</widget>
		<widget source="global.CurrentTime" render="Label" position="155,250" size="550,90" font="FdLcD;90" horizontalAlignment="center" zPosition="10">
			<convert type="ClockToText">LongDate</convert>
		</widget>
		<widget source="session.RecordState" render="FixedLabel" position="375,360" zPosition="3" size="70,70" text=" ">
			<convert type="ConfigEntryTest">config.usage.blinking_rec_symbol_during_recording,True,CheckSourceBoolean</convert>
			<convert type="ConditionalShowHide">Blink</convert>
		</widget>
		<widget source="session.RecordState" render="Pixmap" pixmap="/usr/share/enigma2/display/skin_default/record.png" position="375,360"  size="70,70" >
			<convert type="ConditionalShowHide" />
		</widget>
	</screen>
	<screen name="SkinSelectorSummary" position="0,0" size="800,480">
		<widget source="parent.Title" render="Label" position="0,5" size="795,95" font="FdLcD;75" horizontalAlignment="center" verticalAlignment="center" foregroundColor="#FFFF00" />
		<widget source="Name" render="Label" position="0,101" size="795,90" font="FdLcD;80" horizontalAlignment="center" verticalAlignment="center" />
	</screen>
	<screen name="WizardSummary" position="0,0" size="800,480">
		<widget source="text" render="Label" position="5,5" size="790,194" font="FdLcD;65" horizontalAlignment="center" />
		<widget source="parent.list" render="Label" position="40,200" size="720,279" font="FdLcD;65" horizontalAlignment="center" >
			<convert type="StringListSelection" />
		</widget>
	</screen>
	<include filename="skin_display_templates.xml"/>
</skin>
